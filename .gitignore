.sourceprep/

# Shared data (3D models + placement JSON) — source of truth is the
# webgl-component submodule. iOS bundles copies via a build phase.
# See GeoTestARScene/GeoTestARScene/SHARED_DATA.md for the full strategy.
*.usdz
!GeoTestARScene/GeoTestARScene/skypath_001.usdz
*.glb
# Placement JSON: canonical copy lives in webgl-component/. iOS source
# tree must NEVER carry its own copy — the M02.3 build phase copies the
# canonical file into the bundle at build time. This rule blocks
# accidental re-introduction of an iOS-side copy.
GeoTestARScene/GeoTestARScene/models_to_place.json
GeoTestARScene/GeoTestARScene/skypath_locations*.json
GeoTestARScene/GeoTestARScene/skypath_tour*.json
